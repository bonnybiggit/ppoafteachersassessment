PORT=5000
MONGODB_URI=

CLIENT_URL=http://localhost:5173

# Set a randomly generated secret of at least 32 characters in .env.
JWT_SECRET=
# Positive seconds or a duration using s, m, h, or d.
JWT_EXPIRES_IN=1h

# Optional admin area: independent secret, at least 32 characters, different from JWT_SECRET.
# Leave unset to keep admin authentication disabled. Admin sessions last one hour.
ADMIN_JWT_SECRET=
